MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_SECRET=your-admin-secret-here
ADMIN_EMAIL=admin@gigseva.com
ADMIN_PASSWORD=admin123
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PhonePe Payment Gateway (Sandbox)
PHONEPE_MERCHANT_ID=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=SANDBOX
# Public HTTPS base URL for PhonePe redirects/callbacks (live API host, no /api)
PUBLIC_BASE_URL=https://api.gigseva.com
# Optional web app URL — leave empty for mobile-only. Do NOT set localhost in production.
WEB_APP_URL=
# Optional: set these if you configure callback auth in PhonePe dashboard
PHONEPE_CALLBACK_USERNAME=
PHONEPE_CALLBACK_PASSWORD=
