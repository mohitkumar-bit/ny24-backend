MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_SECRET=your-admin-secret-here
ADMIN_EMAIL=admin@gigseva.com
ADMIN_PASSWORD=admin123
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Payment Gateway (use test keys for development)
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
# Optional merchant id from Razorpay dashboard
RAZORPAY_MERCHANT_ID=
PUBLIC_BASE_URL=https://api.gigseva.com
# Max promo video upload size in MB (set nginx client_max_body_size to match on production)
MAX_VIDEO_UPLOAD_MB=25
# Optional web app URL (gigseva site). Do NOT set localhost in production.
WEB_APP_URL=

# apitxt.com — used for Aadhaar + phone OTP (login/register)
AADHAAR_API_AUTHKEY=
# Optional phone OTP overrides (defaults: SMS, country 91)
# APITXT_OTP_CHANNEL=sms
# APITXT_OTP_TEMPLATE_ID=
# APITXT_OTP_TEMPLATE_NAME=
# APITXT_OTP_COUNTRY=91
# APITXT_OTP_PROJECT_REF_ID=
# Local testing only — never enable in production
# ALLOW_DUMMY_OTP=false
# DUMMY_OTP=123456
